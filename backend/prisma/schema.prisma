// Phase 1: Identity & Access + Taluka/Route. Phase 2: Customer + CustomerContact.
// Phase 3: Contract + RateCard + RateCardComponent (flat/tiered pricing only — no
// usage-based/PER_KG billing in this business, so WasteCategory/MonthlyWasteRecord are
// intentionally not modeled; see docs/BUSINESS_REQUIREMENTS.md open question #1).
// Billing/Payment/Collections models land in their own later phases.
// (per docs/DEVELOPMENT_ROADMAP.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ACCOUNTS_MANAGER
  COLLECTION_EXECUTIVE
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  assignedRoutes Route[]        @relation("RouteExecutive")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String  @id @default(uuid())
  userId        String?
  action        String // e.g. USER_CREATED, USER_ROLE_CHANGED, LOGIN_SUCCEEDED
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Taluka {
  id           String @id @default(uuid())
  name         String @unique
  districtName String @default("Kalaburagi")

  routes    Route[]
  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("talukas")
}

model Route {
  id                  String  @id @default(uuid())
  talukaId            String
  routeNumber         Int
  name                String?
  assignedExecutiveId String?

  taluka            Taluka     @relation(fields: [talukaId], references: [id])
  assignedExecutive User?      @relation("RouteExecutive", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  customers         Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([talukaId, routeNumber])
  @@map("routes")
}

enum CustomerType {
  PRIVATE
  GOVERNMENT
}

enum FacilityType {
  BEDDED_HOSPITAL
  CLINIC
  DENTAL_CLINIC
  LAB
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ContactType {
  PRIMARY
  ACCOUNTS
  OTHER
}

model Customer {
  id               String         @id @default(uuid())
  customerCode     String         @unique
  organizationName String
  customerType     CustomerType
  facilityType     FacilityType
  bedCount         Int?
  talukaId         String
  routeId          String?
  address          String
  city             String
  state            String
  pincode          String
  gstNumber        String?
  panNumber        String?
  paymentTermsDays Int            @default(30)
  status           CustomerStatus @default(ACTIVE)

  taluka Taluka @relation(fields: [talukaId], references: [id])
  route  Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  contacts    CustomerContact[]
  contracts   Contract[]
  rateCards   RateCard[]
  invoices    Invoice[]
  creditNotes CreditNote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([talukaId, status])
  @@index([routeId])
  @@map("customers")
}

model CustomerContact {
  id          String      @id @default(uuid())
  customerId  String
  contactType ContactType
  name        String
  phone       String?
  email       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_contacts")
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum RateCardStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum RateCardComponentType {
  FIXED_FEE
  PER_PICKUP
  PER_BED
  SERVICE_CHARGE
  DISCOUNT
}

model Contract {
  id                 String           @id @default(uuid())
  contractNumber     String           @unique
  customerId         String
  startDate          DateTime
  endDate            DateTime?
  billingFrequency   BillingFrequency
  billingDayOfPeriod Int?
  paymentTermsDays   Int?
  status             ContractStatus   @default(DRAFT)
  activeRateCardId   String?          @unique
  notes              String?

  customer       Customer  @relation(fields: [customerId], references: [id])
  activeRateCard RateCard? @relation("ContractActiveRateCard", fields: [activeRateCardId], references: [id], onDelete: SetNull)
  invoices       Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@map("contracts")
}

model RateCard {
  id            String         @id @default(uuid())
  name          String
  customerId    String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        RateCardStatus @default(DRAFT)

  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  components RateCardComponent[]
  contract   Contract?           @relation("ContractActiveRateCard")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@map("rate_cards")
}

model RateCardComponent {
  id              String                @id @default(uuid())
  rateCardId      String
  componentType   RateCardComponentType
  // Tax-inclusive customer-facing price (e.g. a clinic's flat "Rs 600/month" already
  // includes GST — matches how this business actually quotes and invoices, see the real
  // bill samples in data/). Invoice generation backs out the taxable base from this.
  unitAmount      Decimal               @db.Decimal(14, 2)
  taxable         Boolean               @default(false)
  // Captured per rate-card version (not hardcoded) so a future GST change only requires
  // a new rate card version, not a code change — same versioning philosophy as pricing.
  cgstRatePercent Decimal               @default(2.5) @db.Decimal(5, 2)
  sgstRatePercent Decimal               @default(2.5) @db.Decimal(5, 2)

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rateCardId])
  @@map("rate_card_components")
}

// Single running counter for invoice numbers (continuously incrementing across fiscal
// years, matching the real business's existing numbering — only the FY segment of the
// formatted invoice number changes; the sequence itself never resets). Singleton row.
model InvoiceSequence {
  id         String @id @default("default")
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("invoice_sequences")
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  SENT
  CANCELLED
}

enum InvoiceLineType {
  FIXED_FEE
  PER_PICKUP
  PER_BED
  SERVICE_CHARGE
  DISCOUNT
}

enum CreditNoteStatus {
  DRAFT
  APPROVED
  APPLIED
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  customerId         String
  contractId         String
  invoiceDate        DateTime
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  subtotal           Decimal       @db.Decimal(14, 2)
  taxAmount          Decimal       @db.Decimal(14, 2)
  totalAmount        Decimal       @db.Decimal(14, 2)
  status             InvoiceStatus @default(DRAFT)
  cancelledReason    String?
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?

  customer    Customer          @relation(fields: [customerId], references: [id])
  contract    Contract          @relation(fields: [contractId], references: [id])
  lineItems   InvoiceLineItem[]
  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@index([contractId])
  @@map("invoices")
}

model InvoiceLineItem {
  id              String          @id @default(uuid())
  invoiceId       String
  description     String
  lineType        InvoiceLineType
  quantity        Decimal         @default(1) @db.Decimal(10, 2)
  unitAmount      Decimal         @db.Decimal(14, 2)
  // lineAmount = quantity * unitAmount (tax-inclusive); taxableAmount is the back-computed
  // base once cgst/sgst are subtracted out — see RateCardComponent.unitAmount comment.
  lineAmount      Decimal         @db.Decimal(14, 2)
  taxableAmount   Decimal         @db.Decimal(14, 2)
  cgstRatePercent Decimal         @default(0) @db.Decimal(5, 2)
  cgstAmount      Decimal         @default(0) @db.Decimal(14, 2)
  sgstRatePercent Decimal         @default(0) @db.Decimal(5, 2)
  sgstAmount      Decimal         @default(0) @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model CreditNote {
  id         String           @id @default(uuid())
  invoiceId  String
  customerId String
  reason     String
  amount     Decimal          @db.Decimal(14, 2)
  status     CreditNoteStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?

  invoice   Invoice              @relation(fields: [invoiceId], references: [id])
  customer  Customer             @relation(fields: [customerId], references: [id])
  lineItems CreditNoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([invoiceId])
  @@index([customerId])
  @@map("credit_notes")
}

model CreditNoteLineItem {
  id           String  @id @default(uuid())
  creditNoteId String
  description  String
  amount       Decimal @db.Decimal(14, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([creditNoteId])
  @@map("credit_note_line_items")
}
