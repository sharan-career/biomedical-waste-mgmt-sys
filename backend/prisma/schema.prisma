// Phase 1: Identity & Access + Taluka/Route. Phase 2: Customer + CustomerContact.
// Phase 3: Contract + RateCard + RateCardComponent (flat/tiered pricing only — no
// usage-based/PER_KG billing in this business, so WasteCategory/MonthlyWasteRecord are
// intentionally not modeled; see docs/BUSINESS_REQUIREMENTS.md open question #1).
// Billing/Payment/Collections models land in their own later phases.
// (per docs/DEVELOPMENT_ROADMAP.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ACCOUNTS_MANAGER
  COLLECTION_EXECUTIVE
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  assignedRoutes    Route[]        @relation("RouteExecutive")
  assignedFollowUps FollowUp[]     @relation("FollowUpAssignee")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String  @id @default(uuid())
  userId        String?
  action        String // e.g. USER_CREATED, USER_ROLE_CHANGED, LOGIN_SUCCEEDED
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Taluka {
  id           String @id @default(uuid())
  name         String @unique
  districtName String @default("Kalaburagi")

  routes    Route[]
  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("talukas")
}

model Route {
  id                  String  @id @default(uuid())
  talukaId            String
  routeNumber         Int
  name                String?
  assignedExecutiveId String?

  taluka            Taluka     @relation(fields: [talukaId], references: [id])
  assignedExecutive User?      @relation("RouteExecutive", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  customers         Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([talukaId, routeNumber])
  @@map("routes")
}

enum CustomerType {
  PRIVATE
  GOVERNMENT
}

enum FacilityType {
  BEDDED_HOSPITAL
  CLINIC
  DENTAL_CLINIC
  LAB
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ContactType {
  PRIMARY
  ACCOUNTS
  OTHER
}

model Customer {
  id               String         @id @default(uuid())
  customerCode     String         @unique
  organizationName String
  customerType     CustomerType
  facilityType     FacilityType
  bedCount         Int?
  talukaId         String
  routeId          String?
  address          String
  city             String
  state            String
  pincode          String
  gstNumber        String?
  panNumber        String?
  paymentTermsDays Int            @default(30)
  status           CustomerStatus @default(ACTIVE)

  taluka Taluka @relation(fields: [talukaId], references: [id])
  route  Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  contacts     CustomerContact[]
  contracts    Contract[]
  rateCards    RateCard[]
  invoices     Invoice[]
  creditNotes  CreditNote[]
  payments     Payment[]
  followUps    FollowUp[]
  reminderLogs ReminderLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([talukaId, status])
  @@index([routeId])
  @@map("customers")
}

model CustomerContact {
  id          String      @id @default(uuid())
  customerId  String
  contactType ContactType
  name        String
  phone       String?
  email       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_contacts")
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum RateCardStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum RateCardComponentType {
  FIXED_FEE
  PER_PICKUP
  PER_BED
  SERVICE_CHARGE
  DISCOUNT
}

model Contract {
  id                 String           @id @default(uuid())
  contractNumber     String           @unique
  customerId         String
  startDate          DateTime
  endDate            DateTime?
  billingFrequency   BillingFrequency
  billingDayOfPeriod Int?
  paymentTermsDays   Int?
  status             ContractStatus   @default(DRAFT)
  activeRateCardId   String?          @unique
  notes              String?

  customer       Customer  @relation(fields: [customerId], references: [id])
  activeRateCard RateCard? @relation("ContractActiveRateCard", fields: [activeRateCardId], references: [id], onDelete: SetNull)
  invoices       Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@map("contracts")
}

model RateCard {
  id            String         @id @default(uuid())
  name          String
  customerId    String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        RateCardStatus @default(DRAFT)

  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  components RateCardComponent[]
  contract   Contract?           @relation("ContractActiveRateCard")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@map("rate_cards")
}

model RateCardComponent {
  id              String                @id @default(uuid())
  rateCardId      String
  componentType   RateCardComponentType
  // Tax-inclusive customer-facing price (e.g. a clinic's flat "Rs 600/month" already
  // includes GST — matches how this business actually quotes and invoices, see the real
  // bill samples in data/). Invoice generation backs out the taxable base from this.
  unitAmount      Decimal               @db.Decimal(14, 2)
  taxable         Boolean               @default(false)
  // Captured per rate-card version (not hardcoded) so a future GST change only requires
  // a new rate card version, not a code change — same versioning philosophy as pricing.
  cgstRatePercent Decimal               @default(2.5) @db.Decimal(5, 2)
  sgstRatePercent Decimal               @default(2.5) @db.Decimal(5, 2)

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rateCardId])
  @@map("rate_card_components")
}

// Single running counter for invoice numbers (continuously incrementing across fiscal
// years, matching the real business's existing numbering — only the FY segment of the
// formatted invoice number changes; the sequence itself never resets). Singleton row.
model InvoiceSequence {
  id         String @id @default("default")
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("invoice_sequences")
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceLineType {
  FIXED_FEE
  PER_PICKUP
  PER_BED
  SERVICE_CHARGE
  DISCOUNT
}

enum CreditNoteStatus {
  DRAFT
  APPROVED
  APPLIED
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  customerId         String
  contractId         String
  invoiceDate        DateTime
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  subtotal           Decimal       @db.Decimal(14, 2)
  taxAmount          Decimal       @db.Decimal(14, 2)
  totalAmount        Decimal       @db.Decimal(14, 2)
  // Recomputed from non-reversed PaymentAllocations on every payment/reversal, never
  // hand-set directly — the allocation rows are the source of truth (see EDGE_CASES.md #14).
  paidAmount         Decimal       @default(0) @db.Decimal(14, 2)
  outstandingAmount  Decimal       @db.Decimal(14, 2)
  status             InvoiceStatus @default(DRAFT)
  cancelledReason    String?
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?

  customer     Customer            @relation(fields: [customerId], references: [id])
  contract     Contract            @relation(fields: [contractId], references: [id])
  lineItems    InvoiceLineItem[]
  creditNotes  CreditNote[]
  allocations  PaymentAllocation[]
  followUps    FollowUp[]
  reminderLogs ReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@index([contractId])
  @@map("invoices")
}

model InvoiceLineItem {
  id              String          @id @default(uuid())
  invoiceId       String
  description     String
  lineType        InvoiceLineType
  quantity        Decimal         @default(1) @db.Decimal(10, 2)
  unitAmount      Decimal         @db.Decimal(14, 2)
  // lineAmount = quantity * unitAmount (tax-inclusive); taxableAmount is the back-computed
  // base once cgst/sgst are subtracted out — see RateCardComponent.unitAmount comment.
  lineAmount      Decimal         @db.Decimal(14, 2)
  taxableAmount   Decimal         @db.Decimal(14, 2)
  cgstRatePercent Decimal         @default(0) @db.Decimal(5, 2)
  cgstAmount      Decimal         @default(0) @db.Decimal(14, 2)
  sgstRatePercent Decimal         @default(0) @db.Decimal(5, 2)
  sgstAmount      Decimal         @default(0) @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model CreditNote {
  id         String           @id @default(uuid())
  invoiceId  String
  customerId String
  reason     String
  amount     Decimal          @db.Decimal(14, 2)
  status     CreditNoteStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?

  invoice   Invoice              @relation(fields: [invoiceId], references: [id])
  customer  Customer             @relation(fields: [customerId], references: [id])
  lineItems CreditNoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([invoiceId])
  @@index([customerId])
  @@map("credit_notes")
}

model CreditNoteLineItem {
  id           String  @id @default(uuid())
  creditNoteId String
  description  String
  amount       Decimal @db.Decimal(14, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([creditNoteId])
  @@map("credit_note_line_items")
}

enum PaymentMode {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

model Payment {
  id                  String        @id @default(uuid())
  customerId          String
  amount              Decimal       @db.Decimal(14, 2)
  paymentMode         PaymentMode
  paymentDate         DateTime
  referenceNumber     String?
  bankDetails         String?
  notes               String?
  status              PaymentStatus @default(RECORDED)
  // Set on the ORIGINAL payment once reversed; the reversal itself is a separate Payment
  // row referencing this one — never mutate/delete the original (see EDGE_CASES.md #4).
  reversalOfPaymentId String?       @unique

  customer    Customer            @relation(fields: [customerId], references: [id])
  reversalOf  Payment?            @relation("PaymentReversal", fields: [reversalOfPaymentId], references: [id])
  reversedBy  Payment?            @relation("PaymentReversal")
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([customerId, status])
  @@map("payments")
}

model PaymentAllocation {
  id              String  @id @default(uuid())
  paymentId       String
  // Null invoiceId = unallocated credit balance on the customer (overpayment or advance —
  // see EDGE_CASES.md #8). Negative allocatedAmount = a reversal offsetting an earlier one.
  invoiceId       String?
  allocatedAmount Decimal @db.Decimal(14, 2)

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

enum FollowUpType {
  PHONE_CALL
  WHATSAPP
  EMAIL
  VISIT
  OTHER
}

enum FollowUpStatus {
  OPEN
  FOLLOW_UP_REQUIRED
  PROMISE_TO_PAY
  DISPUTED
  ESCALATED
  CLOSED
}

model FollowUp {
  id                   String         @id @default(uuid())
  customerId           String
  invoiceId            String?
  assignedToId         String
  previousAssignedToId String?
  followUpDate         DateTime
  followUpType         FollowUpType
  contactPerson        String?
  discussionNotes      String?
  customerResponse     String?
  promiseAmount        Decimal?       @db.Decimal(14, 2)
  promisePaymentDate   DateTime?
  nextFollowUpDate     DateTime?
  status               FollowUpStatus @default(OPEN)
  // Each state transition creates a NEW row rather than mutating this one (see
  // BUSINESS_WORKFLOW.md §4) — previousFollowUpId chains them so full history is
  // reconstructable; the row nothing else points to via this chain is "the current one".
  previousFollowUpId   String?        @unique
  // True for rows created by the overdue-invoice / broken-promise scheduled jobs, not a
  // human — lets the "Follow-ups Today" screen visually flag these (see EDGE_CASES.md #10).
  isSystemGenerated    Boolean        @default(false)

  customer         Customer  @relation(fields: [customerId], references: [id])
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])
  assignedTo       User      @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  previousFollowUp FollowUp? @relation("FollowUpChain", fields: [previousFollowUpId], references: [id])
  nextFollowUp     FollowUp? @relation("FollowUpChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([assignedToId, status, nextFollowUpDate])
  @@index([customerId])
  @@index([invoiceId])
  @@map("follow_ups")
}

enum ReminderTriggerType {
  DAYS_BEFORE_DUE
  ON_DUE_DATE
  DAYS_AFTER_DUE
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum ReminderDeliveryStatus {
  SENT
  FAILED
  DELIVERED
  READ
}

model ReminderRule {
  id                String              @id @default(uuid())
  name              String
  triggerType       ReminderTriggerType
  triggerOffsetDays Int                 @default(0)
  channel           ReminderChannel
  messageTemplate   String
  active            Boolean             @default(true)

  logs ReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@map("reminder_rules")
}

model ReminderLog {
  id             String                 @id @default(uuid())
  ruleId         String
  customerId     String
  invoiceId      String
  channel        ReminderChannel
  message        String
  sentAt         DateTime?
  deliveryStatus ReminderDeliveryStatus
  // Bounded retry (see EDGE_CASES.md #12) — each daily job run retries a FAILED row (updating
  // this same row, never creating a new one) until retryCount hits the cap, then it's left
  // FAILED and surfaced for visibility rather than retried forever.
  retryCount     Int                    @default(0)
  lastError      String?
  responseText   String?
  responseAt     DateTime?

  rule     ReminderRule @relation(fields: [ruleId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  invoice  Invoice      @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One rule fires at most once (ever) per invoice — this row IS the duplicate-suppression
  // key (see BUSINESS_WORKFLOW.md §5 and EDGE_CASES.md #12); retries update it in place.
  @@unique([ruleId, invoiceId])
  @@index([deliveryStatus])
  @@index([customerId])
  @@map("reminder_logs")
}
