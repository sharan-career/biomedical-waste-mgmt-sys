// Phase 1: Identity & Access + Taluka/Route. Phase 2: Customer + CustomerContact.
// Contract/Billing/Payment/Collections models land in their own later phases.
// (per docs/DEVELOPMENT_ROADMAP.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ACCOUNTS_MANAGER
  COLLECTION_EXECUTIVE
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  assignedRoutes Route[]        @relation("RouteExecutive")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String  @id @default(uuid())
  userId        String?
  action        String // e.g. USER_CREATED, USER_ROLE_CHANGED, LOGIN_SUCCEEDED
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Taluka {
  id           String @id @default(uuid())
  name         String @unique
  districtName String @default("Kalaburagi")

  routes    Route[]
  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("talukas")
}

model Route {
  id                  String  @id @default(uuid())
  talukaId            String
  routeNumber         Int
  name                String?
  assignedExecutiveId String?

  taluka            Taluka     @relation(fields: [talukaId], references: [id])
  assignedExecutive User?      @relation("RouteExecutive", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  customers         Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([talukaId, routeNumber])
  @@map("routes")
}

enum CustomerType {
  PRIVATE
  GOVERNMENT
}

enum FacilityType {
  BEDDED_HOSPITAL
  CLINIC
  DENTAL_CLINIC
  LAB
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ContactType {
  PRIMARY
  ACCOUNTS
  OTHER
}

model Customer {
  id               String         @id @default(uuid())
  customerCode     String         @unique
  organizationName String
  customerType     CustomerType
  facilityType     FacilityType
  bedCount         Int?
  talukaId         String
  routeId          String?
  address          String
  city             String
  state            String
  pincode          String
  gstNumber        String?
  panNumber        String?
  paymentTermsDays Int            @default(30)
  status           CustomerStatus @default(ACTIVE)

  taluka Taluka @relation(fields: [talukaId], references: [id])
  route  Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  contacts CustomerContact[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([talukaId, status])
  @@index([routeId])
  @@map("customers")
}

model CustomerContact {
  id          String      @id @default(uuid())
  customerId  String
  contactType ContactType
  name        String
  phone       String?
  email       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_contacts")
}
