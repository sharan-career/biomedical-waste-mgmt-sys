DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biomedical_waste_mgmt?schema=public"

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
